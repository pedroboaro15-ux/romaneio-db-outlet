# Copie para ".env" pra rodar "netlify dev" localmente.
# Em produção, essas mesmas variáveis vão em: Netlify -> Site settings -> Environment variables.

OMIE_APP_KEY=
OMIE_APP_SECRET=

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# E-mail do seu usuário no Supabase Auth (o único que pode logar no painel).
ADMIN_EMAIL=
