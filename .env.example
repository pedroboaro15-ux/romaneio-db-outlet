# Copie para ".env" pra rodar "netlify dev" localmente.
# Em produção, essas mesmas variáveis vão em: Netlify -> Site settings -> Environment variables.

OMIE_APP_KEY=
OMIE_APP_SECRET=

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# E-mail do seu usuário no Supabase Auth (o único que pode logar no painel).
ADMIN_EMAIL=

# Opcional — só pro botão "Tentar identificar com IA" na aba Vendas.
# Chave de API do Google AI Studio (começa com "AIza"). Sem ela o app funciona
# igual, só que os pedidos fora do padrão ficam pra você arrumar na mão.
GEMINI_API_KEY=
# Opcional. Só mexa se o Google aposentar o modelo padrão (gemini-2.0-flash).
GEMINI_MODEL=
