# Copie para ".env" (e para ".dev.vars", que é o que o `wrangler dev` lê) pra
# rodar na sua máquina. Em produção: Cloudflare -> Workers & Pages -> seu Worker
# -> Settings -> Variables and Secrets.

OMIE_APP_KEY=
OMIE_APP_SECRET=

# O MESMO projeto do Supabase serve os dois apps (romaneio e estoque). Dois
# projetos = duas sessões = dois logins; ver supabase/schema.sql.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Quem pode abrir o painel do romaneio, como rede de segurança: lista de e-mails
# separada por vírgula. Só vale enquanto a tabela "perfis" (do schema-estoque.sql)
# não existir ou a sua conta não tiver perfil lá. Depois disso, quem manda é
# perfis.papel = 'dono' — é assim que dá pra ter dois donos sem redeploy.
ADMIN_EMAILS=

# --- app de estoque (/estoque) ---
# O Vite troca isso pelo valor literal no build, então vai pro código do site.
# A chave "anon" é pública de propósito: o que protege os dados é o RLS no banco.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Opcional — só pro botão "Tentar identificar com IA" na aba Vendas.
# Chave de API do Google AI Studio (começa com "AIza"). Sem ela o app funciona
# igual, só que os pedidos fora do padrão ficam pra você arrumar na mão.
GEMINI_API_KEY=
# Opcional. Só mexa se o Google aposentar o modelo padrão (gemini-2.0-flash).
GEMINI_MODEL=
